{
  "name": "gruyereka-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web client for Gruyereka: rate the cheese you bought, and the shop you bought it from.",
  "license": "Apache-2.0",
  "author": "Guillaume Leroy <gleroy@therealm.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therealm-tech/gruyereka.git",
    "directory": "gruyereka-web"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-brand.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-brand.mjs",
    "build": "next build",
    "start": "next start",
    "check": "biome check",
    "check:write": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.18"
    }
  }
}
