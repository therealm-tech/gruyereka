# Development defaults, so `npm run dev` works against the Compose stack
# straight after a clone. Next.js loads this file on its own; `process.env`
# takes precedence over it, so an exported value always wins.
#
# `.env.development` is read only when NODE_ENV is `development`, which means
# `next dev` and nothing else. A production build and `next start` take their
# configuration from the environment, so this file cannot follow the app into
# an image.
#
# Personal overrides go in `.env.local`, which git ignores.

API_BASE_URL=http://localhost:8787
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
